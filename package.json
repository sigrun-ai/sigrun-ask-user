{
  "name": "@sigrun/ask-user",
  "version": "0.1.0",
  "description": "Lets the agent ask the user structured questions and wait for the answer",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node scripts/check-manifest.mjs --expect-name @sigrun/ask-user && vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.3.0 || 1.4.0",
    "@earendil-works/pi-ai": "1.3.0 || 1.4.0",
    "@earendil-works/pi-durable": "1.3.0 || 1.4.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@sigrun/shared": "file:../sigrun/shared",
    "@sigrun/sigrun": "file:../sigrun",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "git+https://github.com/sigrun-ai/sigrun-ask-user.git"
  },
  "bugs": {
    "url": "https://github.com/sigrun-ai/sigrun-ask-user/issues"
  },
  "homepage": "https://github.com/sigrun-ai/sigrun-ask-user#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
